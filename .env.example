# ResearchX Configuration

# Storage & Infrastructure
DATABASE_URL=postgresql://researchx:researchx_password@localhost:5432/researchx
USE_PGVECTOR=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Provider Configuration ('gemini', 'openai', or 'mock')
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Loaded strictly from environment)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Search Provider ('duckduckgo', 'tavily', 'serper', or 'mock')
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Hybrid RAG Weights
RAG_SEMANTIC_WEIGHT=0.65
RAG_KEYWORD_WEIGHT=0.25
RAG_QUALITY_WEIGHT=0.10

# Quality Control Threshold
QC_SCORE_THRESHOLD=75.0
QC_MAX_REVISIONS=2
